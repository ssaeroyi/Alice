APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Admin "View as" preview and the DEV TOOLS overlay it exposes. Fail-closed:
# leave false everywhere except a local dev box.
DEV_TOOLS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

APP_TIMEZONE=Asia/Manila

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alice_ver2
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set to true in production to encrypt session data at rest.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production once HTTPS is configured — the browser will only
# send the session cookie over HTTPS. Leave false on HTTP dev boxes.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=youremail@gmail.com
MAIL_PASSWORD="your-app-password"
MAIL_FROM_ADDRESS="youremail@gmail.com"
MAIL_FROM_NAME="Alice"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Narration TTS (tools/narration/generate_narration.py) ---
# NARRATION_LOCAL_GENERATOR is for the AUTHORING MACHINE ONLY (a Python/venv
# interpreter path, e.g. C:\laragon\bin\python\python-3.13\python.exe). It
# makes the teacher "Generate narration" button auto-run the generator in the
# background for the clicked story. It MUST stay empty in production: the
# hosted site only queues (wanted.json) and lets the authoring machine pull
# via feed mode (NARRATION_FEED_TOKEN).
NARRATION_VOICE=af_heart
NARRATION_MODEL=kokoro-v1.0
NARRATION_LOCAL_GENERATOR=
NARRATION_LOCAL_GENERATOR_LOG=
NARRATION_FEED_TOKEN=
NARRATION_STALL_SECONDS=600

VITE_APP_NAME="${APP_NAME}"
